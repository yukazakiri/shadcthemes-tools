{
  "name": "yukzakiri/shadcthemes-tools",
  "description": "Theme management Artisan commands for tweakcn themes.",
  "type": "library",
  "keywords": [
    "laravel",
    "inertia",
    "shadcn",
    "themes",
    "tailwindcss",
    "tweakcn"
  ],
  "homepage": "https://github.com/yukzakiri/shadcthemes-tools",
  "license": "MIT",
  "authors": [
    {
      "name": "Yukzakiri"
    }
  ],
  "support": {
    "issues": "https://github.com/yukzakiri/shadcthemes-tools/issues",
    "source": "https://github.com/yukzakiri/shadcthemes-tools"
  },
  "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "illuminate/console": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "laravel/prompts": "^0.3.0"
  },
  "autoload": {
    "psr-4": {
      "Yukzakiri\\ThemeTools\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "lint": "vendor/bin/pint",
    "refactor": "vendor/bin/rector process",
    "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Yukzakiri\\ThemeTools\\ThemeToolsServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "pestphp/pest": "*",
    "laravel/pint": "*",
    "phpstan/phpstan": "*",
    "rector/rector": "*"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
